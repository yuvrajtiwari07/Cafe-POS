rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'rajtiwari07102001@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getCafe(cafeId) {
      return get(/databases/$(database)/documents/cafes/$(cafeId)).data;
    }

    function isDocOwner() {
      return isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isBootstrappedAdmin()
      );
    }

    function isCafeOwner(cafeId) {
      return isSignedIn() && (
        getCafe(cafeId).ownerId == request.auth.uid ||
        getCafe(cafeId).ownerEmail == request.auth.token.email ||
        isBootstrappedAdmin()
      );
    }

    function isCafeStaff(cafeId) {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        getCafe(cafeId).ownerId == request.auth.uid ||
        getCafe(cafeId).ownerEmail == request.auth.token.email ||
        (getCafe(cafeId).memberUids is list && request.auth.uid in getCafe(cafeId).memberUids)
      );
    }

    // Cafes Collection
    match /cafes/{cafeId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        isValidId(cafeId) &&
        (incoming().ownerId == request.auth.uid || isBootstrappedAdmin()) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100;

      allow update: if isSignedIn() && (
        isDocOwner() ||
        // Allow claiming an unowned/guest cafe doc when signing in
        (
          (existing().ownerId == 'guest-owner' || existing().ownerId == 'guest-cashier' || !('ownerId' in existing())) &&
          incoming().ownerId == request.auth.uid
        ) ||
        // Allow applicant or staff to join, sync members, or add join requests without altering cafe ownership
        (
          incoming().ownerId == existing().ownerId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'members', 'pendingRequests', 'updatedAt'])
        ) ||
        // Allow authorized cafe staff to update linked Google Sheets backup metadata without altering ownership
        (
          (existing().memberUids is list && request.auth.uid in existing().memberUids) &&
          incoming().ownerId == existing().ownerId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'googleSpreadsheetId',
            'googleSpreadsheetUrl',
            'googleSheetTitle',
            'lastSheetSyncedAt',
            'initialExpensesSeededAt',
            'updatedAt'
          ])
        )
      );

      allow delete: if isDocOwner();

      // Subcollection: Menu Items
      match /menu/{itemId} {
        allow read: if isCafeStaff(cafeId);
        allow create, update: if isCafeStaff(cafeId) &&
          isValidId(itemId) &&
          incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
          incoming().price is number && incoming().price >= 0;
        allow delete: if isCafeStaff(cafeId);
      }

      // Subcollection: Bills / Orders
      match /bills/{billId} {
        allow read: if isCafeStaff(cafeId);
        allow create: if isCafeStaff(cafeId) &&
          isValidId(billId) &&
          incoming().billNumber is string && incoming().billNumber.size() > 0 &&
          incoming().grandTotal is number && incoming().grandTotal >= 0 &&
          incoming().items is list && incoming().items.size() > 0;
        allow update: if isCafeStaff(cafeId);
        allow delete: if isCafeOwner(cafeId);
      }

      // Subcollection: Active Shared Tables & Carts
      match /tables/{tableId} {
        allow read: if isCafeStaff(cafeId);
        allow write: if isCafeStaff(cafeId);
      }

      // Subcollection: Raw Inventory Items
      match /inventory/{itemId} {
        allow read: if isCafeStaff(cafeId);
        allow create, update: if isCafeStaff(cafeId) &&
          isValidId(itemId) &&
          incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100;
        allow delete: if isCafeOwner(cafeId);
      }

      // Subcollection: Recipe BOM Mappings
      match /recipes/{recipeId} {
        allow read: if isCafeStaff(cafeId);
        allow create, update: if isCafeStaff(cafeId) &&
          isValidId(recipeId) &&
          incoming().menuItemId is string;
        allow delete: if isCafeOwner(cafeId);
      }

      // Subcollection: Inventory Audit Movements (Append-only)
      match /inventoryMovements/{movementId} {
        allow read: if isCafeStaff(cafeId);
        allow create: if isCafeStaff(cafeId) &&
          isValidId(movementId) &&
          incoming().ingredientId is string;
        allow update, delete: if false;
      }

      // Subcollection: Cash, UPI & Credit Card Ledger (Expenditures, Withdrawals, CC Top-Ups & Partner Spends)
      match /ledger/{entryId} {
        allow read: if isCafeStaff(cafeId);
        allow create, update: if isCafeStaff(cafeId) &&
          isValidId(entryId) &&
          incoming().cafeId is string && incoming().cafeId == cafeId &&
          incoming().kind in ['expenditure', 'withdrawal', 'cc_topup'] &&
          incoming().amount is number && incoming().amount > 0 &&
          incoming().paymentMode in ['cash', 'upi', 'credit_card', 'personal'] &&
          (!('expenseType' in incoming()) || incoming().expenseType in ['running', 'fixed', 'initial']) &&
          (!('paidBy' in incoming()) || (incoming().paidBy is string && incoming().paidBy.size() <= 60)) &&
          (!('expenseTitle' in incoming()) || (incoming().expenseTitle is string && incoming().expenseTitle.size() <= 120)) &&
          incoming().dateStr is string && incoming().dateStr.size() == 10 &&
          incoming().note is string && incoming().note.size() <= 250 &&
          incoming().createdAt is string && incoming().createdAt.size() <= 60;
        allow delete: if isCafeStaff(cafeId);
      }

      // Subcollection: Wallet Opening Balance & Settings
      match /settings/{settingId} {
        allow read: if isCafeStaff(cafeId);
        allow create, update: if isCafeStaff(cafeId) &&
          isValidId(settingId) &&
          incoming().cash is number &&
          incoming().upi is number &&
          incoming().creditCard is number;
        allow delete: if isCafeOwner(cafeId);
      }
    }
  }
}
